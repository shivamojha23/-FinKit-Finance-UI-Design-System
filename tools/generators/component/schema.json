{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "id": "component",
  "title": "Create a UI component",
  "description": "Scaffolds a new React component with CSS, test, story, and barrel export.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in PascalCase (e.g. PriceChart).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Component name (PascalCase):"
    }
  },
  "required": ["name"]
}
